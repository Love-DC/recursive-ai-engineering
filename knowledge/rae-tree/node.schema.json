{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Love-DC/recursive-ai-engineering/blob/main/knowledge/rae-tree/node.schema.json",
  "title": "RAE Recursive Engineering Node",
  "description": "A compact, repository-local node in the recursive engineering context tree. It is distinct from a Supabase executable task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node_id",
    "node_type",
    "project_key",
    "title",
    "goal",
    "status",
    "summary",
    "parent_node_id",
    "children_index",
    "context_refs",
    "evidence_refs",
    "dependency_refs",
    "task_refs",
    "wake_conditions",
    "last_activity_at",
    "last_reviewed_at",
    "next_review_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "node_type": {
      "enum": [
        "root",
        "project",
        "domain",
        "system",
        "initiative",
        "decision",
        "knowledge",
        "workstream"
      ]
    },
    "project_key": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "status": {
      "enum": [
        "active",
        "dormant",
        "blocked",
        "completed",
        "archived"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 1200
    },
    "parent_node_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "children_index": {
      "type": [
        "string",
        "null"
      ],
      "description": "Repository-relative path to a compact child index or shard manifest."
    },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "file",
              "commit",
              "pull_request",
              "issue",
              "ci_run",
              "task",
              "execution",
              "query",
              "external"
            ]
          },
          "ref": {
            "type": "string"
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "note": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "dependency_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "reason"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          },
          "required": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "task_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "wake_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      },
      "uniqueItems": true
    },
    "last_activity_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "next_review_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "checkpoint_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
